# Backend API URL
# For local development: http://localhost:5000
# For production: https://rdot-me-backend-services-imran-khans-projects-b3df5052.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000

# Cloudinary Configuration (for image uploads - REQUIRED for Vercel deployment)
# Sign up at https://cloudinary.com (free tier available)
CLOUDINARY_CLOUD_NAME=your-cloud-name-here
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here

# MongoDB Configuration (if using MongoDB Atlas for production)
MONGODB_URI=mongodb://localhost:27017/researchersdb
